{
  "name": "hitchmark",
  "displayName": "Hitchmark",
  "description": "Stable, addressable hook:// links to files and paragraphs",
  "version": "0.1.0",
  "publisher": "hitchmark",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/hitchmark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["hitchmark", "hook", "links", "purple numbers", "addressable"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hitchmark.copyUri",
        "title": "Hitchmark: Copy hook:// URI for Current File"
      },
      {
        "command": "hitchmark.copyUriWithParagraph",
        "title": "Hitchmark: Copy hook:// URI with Paragraph ID"
      },
      {
        "command": "hitchmark.listLinks",
        "title": "Hitchmark: Show Links for Current File"
      },
      {
        "command": "hitchmark.openUri",
        "title": "Hitchmark: Open hook:// URI from Clipboard"
      },
      {
        "command": "hitchmark.showPurpleNumbers",
        "title": "Hitchmark: Show Purple Numbers for Current File"
      },
      {
        "command": "hitchmark.startServer",
        "title": "Hitchmark: Start hk serve"
      }
    ],
    "configuration": {
      "title": "Hitchmark",
      "properties": {
        "hitchmark.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the hk binary. Leave blank to auto-detect."
        },
        "hitchmark.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:2701",
          "description": "URL of the hk serve HTTP server. Leave blank to use subprocess."
        },
        "hitchmark.autoDetectServer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically use the HTTP server if it is running."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "hitchmark.copyUri",
          "group": "hitchmark@1",
          "when": "editorFocus"
        },
        {
          "command": "hitchmark.copyUriWithParagraph",
          "group": "hitchmark@2",
          "when": "editorFocus && editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "hitchmark.copyUri",
          "group": "hitchmark@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hitchmark.copyUri",
        "key": "ctrl+alt+h",
        "mac": "ctrl+alt+h",
        "when": "editorFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "compile": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/src/**/*.test.ts"]
  }
}
