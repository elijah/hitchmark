{
  "name": "hookmarks-obsidian",
  "version": "0.1.0",
  "description": "Obsidian plugin for purple numbers and hook:// link management",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "test": "jest --passWithNoTests"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^obsidian$": "<rootDir>/__mocks__/obsidian.ts",
      "^@codemirror/(.*)$": "<rootDir>/__mocks__/codemirror.ts"
    }
  },
  "keywords": [
    "obsidian",
    "hookmarks",
    "purple-numbers",
    "links"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "eslint": "^8.56.0",
    "obsidian": "latest",
    "ts-jest": "^29.4.11",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.3"
  }
}
