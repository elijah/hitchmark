/**
 * Hookmarks OneNote Add-in manifest.
 *
 * Platforms supported:
 *   - OneNote Online (web, any OS including macOS)
 *   - OneNote for Windows (desktop + UWP)
 *
 * Note: The native OneNote macOS app does NOT support Office Add-ins.
 * macOS users should use OneNote Online in a browser.
 *
 * To sideload during development:
 *   Windows: Copy this file to %APPDATA%\Microsoft\AddIns\
 *   Web: Use Insert → Office Add-ins → Upload My Add-in
 */
<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Hookmarks</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Hookmarks"/>
  <Description DefaultValue="Stable, addressable hook:// links and purple numbers for OneNote pages"/>
  <IconUrl DefaultValue="https://127.0.0.1:3000/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://127.0.0.1:3000/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/yourusername/not-hookmarks"/>

  <AppDomains>
    <AppDomain>https://127.0.0.1:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Notebook"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://127.0.0.1:3000/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Notebook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="CommandsApp">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="CopyUriButton">
                  <Label resid="CopyUri.Label"/>
                  <Supertip>
                    <Title resid="CopyUri.Label"/>
                    <Description resid="CopyUri.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>copyCurrentPageUri</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://127.0.0.1:3000/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://127.0.0.1:3000/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://127.0.0.1:3000/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://127.0.0.1:3000/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://127.0.0.1:3000/taskpane.html"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/yourusername/not-hookmarks"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Get started with Hookmarks"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="Hookmarks"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Hookmarks Panel"/>
        <bt:String id="CopyUri.Label" DefaultValue="Copy hook:// URI"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Hookmarks creates stable links to OneNote pages and sections."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open the Hookmarks panel to manage links and purple numbers."/>
        <bt:String id="CopyUri.Tooltip" DefaultValue="Copy a stable hook:// URI for the current page to the clipboard."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
