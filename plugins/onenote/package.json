{
  "name": "hookmarks-onenote",
  "displayName": "Hookmarks for OneNote",
  "version": "0.1.0",
  "description": "Stable hook:// links and purple numbers for OneNote pages",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "build:prod": "node esbuild.config.mjs --production",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "tsc --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@microsoft/office-js": "^1.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/src/**/*.test.ts"]
  }
}
