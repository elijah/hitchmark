{
  "name": "hookmarks-web-extension",
  "version": "0.2.0",
  "description": "Hookmarks Web Extension (Safari / Chrome / Edge / Brave)",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:prod": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "test": "jest",
    "package:chrome": "npm run build:prod && node scripts/package-chrome.mjs",
    "package:edge": "npm run build:prod && node scripts/package-chrome.mjs --edge"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"]
  }
}
